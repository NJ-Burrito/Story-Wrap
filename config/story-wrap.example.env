# Copy to ~/.config/story-wrap/story-wrap.env (or export in your shell). Never commit real values.
# Paths
STORYWRAP_ROOT=/path/to/your/story-wrap-checkout     # repo root; default: the checkout holding tools/
SW_FONTS=/path/to/your/fonts                          # your own licensed Arabic fonts (none are shipped)
# Accounts (your own brand accounts, official APIs only)
SW_OWN_ACCOUNTS=your_instagram_handle                 # comma list; your own accounts are never replied to
SW_PAGE_NAME=Your Page Name
SW_SERIES_NAME=Your Series Name
SW_INSTAGRAM_URL=https://www.instagram.com/your_instagram_handle/
SW_YOUTUBE_URL=https://www.youtube.com/channel/YOUR_CHANNEL_ID
SW_YT_CHANNEL_ID=YOUR_CHANNEL_ID
SW_YT_PLAYLIST_TITLE=Your Series Name
SW_MEDIA_REPO=your-github-user/your-media-host-repo   # public repo whose temporary releases host video for Instagram
# Credential files (paths; contents are never in the repo)
SW_IG_ENV=~/.config/story-wrap/instagram.env          # see instagram.example.env
SW_GH_ENV=~/.config/story-wrap/github.env             # see github.example.env
SW_YT_TOKEN=~/.config/story-wrap/youtube-token.json   # OAuth authorised-user JSON from your own Google project
# Budgets
SW_LLM_DAILY_TOKENS=5000000
