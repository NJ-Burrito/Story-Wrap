     },
     "depth_z": {
      "type": "object",
      "additionalProperties": {
       "type": "number"
      },
      "description": "Per-beat override of actors[].depth_z (an actor walks nearer or farther)."
     },
     "draw_order": {
      "type": "array",
      "description": "Who is in front, per time window, back to front. Required when the beat shows 2+ actors. A token is an actor id ('partner' = body then arms) or 'id:body' / 'id:arms' to split (her arm in front of his body). Windows tile the beat; a change or a split needs a why (>= 12 chars). Must follow depth_z (farther first) unless split.",
      "items": {
       "type": "object",
       "required": [
        "order"
       ],
       "properties": {
        "t0": {
         "type": "number"
        },
        "t1": {
         "type": "number"
        },
        "order": {
         "type": "array",
         "items": {
          "type": "string"
         }
        },
        "why": {
         "type": "string"
        }
       }
      }
     },
     "actor_emotions": {
      "type": "object",
      "description": "One emotion block per actor when the beat shows 2+ actors: {<actor id>: {emotion, emotion_track, emotion_change?}}, each checked by the EMO-* checks on its own (named 'actor <id>'). A one-character beat keeps beat.emotion / beat.emotion_track.",
      "additionalProperties": {
       "type": "object",
       "required": [
        "emotion",
        "emotion_track"
       ],
       "properties": {
        "emotion": {
         "type": "object"
        },
