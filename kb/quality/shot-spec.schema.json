  "actors": {
   "type": "array",
   "description": "Several characters in one shot (tools/render/characters/README.md, 'Several characters in one shot'). One entry per character INSTANCE; each id has a characters[] rig entry with the same id. Omit for a one-character shot. Checks ACTOR-DECLARED.",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "module",
     "depth_z",
     "layer",
     "catalogue_refs"
    ],
    "properties": {
     "id": {
      "type": "string",
      "description": "Instance id; the key of this actor in rig-trace characters{}, in draw orders, interactions and masks/<kind>/<id>/."
     },
     "module": {
      "type": "string",
      "description": "tools/render/characters/<module>.js. Two instances may share a module."
     },
     "depth_z": {
      "type": "number",
      "description": "Metres from the camera plane (larger = farther). Draw order must follow it (ACTOR-ORDER, ACTOR-OCCLUSION)."
     },
     "layer": {
      "type": "integer",
      "description": "Stacking slot when two actors have the same depth_z (higher is drawn later)."
     },
     "catalogue_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      },
      "description": "id@version entries of this actor's character catalogue; each starts with '<module>/'."
     }
    }
   }
  },
  "actor_interactions": {
   "type": "array",
   "description": "Touches between actors, checked on the trace (ACTOR-CONTACT, HANDOVER). A beat that shows two or more actors needs at least one, or beat.actors_apart_because.",
   "items": {
    "type": "object",
    "required": [
     "id",
     "kind",
     "beat",
     "t0",
     "t1",
     "why"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "contact",
       "handover",
       "apart"
      ],
      "description": "apart = a declared NO-TOUCH (CLAUDE.md, the owner 2026-10-23): a: {actor, hands: [L, R]}, b: {actor, hands}, min_gap_px; ACTOR-CONTACT checks the drawn hand outlines (trace hand_outline_px) stay that far apart on every frame both actors are present"
     },
     "beat": {
      "type": "string"
     },
     "t0": {
      "type": "number"
     },
     "t1": {
      "type": "number",
      "description": "Window [t0, t1) in seconds, inside the beat; checked on every frame of it."
     },
     "why": {
      "type": "string",
      "description": ">= 12 chars: the story reason for the touch."
     },
     "a": {
      "type": "object",
      "description": "contact: {actor, point}; point = a name in that actor's trace contact_points or anchors (hand_L, hand_R, wrist_L, ...).",
      "properties": {
       "actor": {
        "type": "string"
       },
       "point": {
        "type": "string"
       }
      }
     },
     "b": {
      "type": "object",
      "description": "contact: {actor, point} (hand to hand, hand to body) or {prop, held_by:{actor, hand}} (a hand to an object the OTHER actor holds; the prop must be parented to that hand on every frame).",
      "properties": {
       "actor": {
        "type": "string"
       },
       "point": {
        "type": "string"
       },
       "prop": {
        "type": "string"
       },
       "held_by": {
        "type": "object",
        "properties": {
         "actor": {
          "type": "string"
         },
         "hand": {
          "enum": [
           "L",
           "R"
          ]
         }
        }
       }
      }
     },
     "tol_px": {
      "type": "number",
      "description": "contact: canvas px between the two points on every frame (default 8, at most 16)."
     },
     "prop": {
      "type": "string",
      "description": "handover: id in props[]."
     },
     "giver": {
      "type": "object",
      "properties": {
       "actor": {
        "type": "string"
       },
       "hand": {
        "enum": [
         "L",
         "R"
        ]
       }
      }
     },
     "receiver": {
      "type": "object",
      "properties": {
       "actor": {
        "type": "string"
       },
       "hand": {
        "enum": [
         "L",
         "R"
        ]
       }
      }
     },
     "handoff_frame": {
      "type": "integer",
      "description": "handover: the first frame the prop's parent is the receiver's hand; before it the giver's hand. Strictly inside t0..t1 in frames."
     },
     "both_hands_frames": {
      "type": "integer",
      "description": "handover: both hands on the prop (gap <= 8 px) for this many frames before handoff_frame (default and minimum 3)."
     },
     "max_jump_px": {
      "type": "number",
      "description": "handover: largest prop travel between handoff_frame - 1 and handoff_frame (default 16)."
     }
    }
   }
  }
 }
