         "type": "object"
        },
        "emotion_change": {
         "type": "object"
        }
       }
      }
     },
     "actors_apart_because": {
      "type": "string",
      "description": "A beat that shows 2+ actors with no actor_interactions says why (they never touch, on purpose)."
     }
    }
